VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Reusable AI Service API Key (Gemini or OpenAI)
AI_API_KEY=your_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
AI_CACHE_TTL_SECONDS=86400

# Provider fallback order — if one provider fails, the next one is tried automatically
# Available providers: groq, mistral, sambanova, cerebras, cohere, cloudflare, huggingface, gemini, openrouter, openai
AI_PROVIDER_ORDER=groq,mistral,sambanova,cerebras,cohere,cloudflare,huggingface,gemini,openrouter,openai

# RAG knowledge base. Ingestion is server-only; retrieval uses the authenticated API.
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.15
RAG_TIMEOUT_MS=8000
RAG_EMBEDDING_TIMEOUT_MS=8000
RAG_EMBEDDING_PROVIDER_ORDER=openai,local
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_INGEST_KEY=replace_with_a_server_only_ingestion_key

# Optional provider used when the primary provider is unavailable
AI_FALLBACK_API_KEY=your_fallback_provider_key
AI_FALLBACK_MODEL=gpt-4o-mini

# Optional additional server-side provider keys. Never prefix these with VITE_.
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=your_openai_key

# Optional server-side providers. Never prefix these with VITE_.
GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.1-8b-instant
HUGGINGFACE_API_KEY=your_huggingface_token
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Mistral AI (Free tier — https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest

# SambaNova Cloud (Free tier — https://cloud.sambanova.ai/)
SAMBANOVA_API_KEY=your_sambanova_api_key
SAMBANOVA_MODEL=Meta-Llama-3.1-8B-Instruct

# Cohere (Free tier — https://dashboard.cohere.com/)
COHERE_API_KEY=your_cohere_api_key
COHERE_MODEL=command-r

# Cloudflare Workers AI (Free tier — https://dash.cloudflare.com/)
CLOUDFLARE_API_KEY=your_cloudflare_api_key
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Cerebras (Free tier — https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=your_cerebras_api_key
CEREBRAS_MODEL=llama3.1-8b

# Optional server-side job provider. Leave unset to use CareerAI Demo Data.
JOB_PROVIDER=rest
JOB_PROVIDER_NAME=Configured Job Provider
JOB_PROVIDER_URL=https://your-job-provider.example/jobs
JOB_PROVIDER_API_KEY=your_server_only_job_provider_key
JOB_PROVIDER_TIMEOUT_MS=8000

# Admin System Access
ADMIN_EMAIL=admin@careerai.com